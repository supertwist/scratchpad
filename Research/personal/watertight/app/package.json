{
  "name": "watertight",
  "productName": "Watertight",
  "version": "1.0.0",
  "description": "Check and repair STL meshes so they are watertight and ready to 3D print",
  "author": "Corcoran Fab Lab",
  "license": "MIT",
  "main": "main.js",
  "private": true,
  "scripts": {
    "sync": "bash ../sync.sh",
    "start": "npm run sync && electron .",
    "dist": "npm run sync && electron-builder --mac --arm64",
    "dist:intel": "npm run sync && electron-builder --mac --x64",
    "dist:universal": "npm run sync && electron-builder --mac --universal",
    "pack": "npm run sync && electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "edu.gwu.corcoran.watertight",
    "productName": "Watertight",
    "copyright": "Corcoran Fab Lab, George Washington University",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "main.js",
      "preload.js",
      "renderer/**/*",
      "!**/*.map"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "extendInfo": {
        "NSHumanReadableCopyright": "Corcoran Fab Lab, GWU",
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "STL mesh",
            "CFBundleTypeRole": "Editor",
            "LSItemContentTypes": [
              "public.standard-tesselated-geometry-format"
            ],
            "CFBundleTypeExtensions": [
              "stl"
            ]
          }
        ]
      }
    },
    "dmg": {
      "title": "Watertight ${version}",
      "contents": [
        {
          "x": 145,
          "y": 200,
          "type": "file"
        },
        {
          "x": 405,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}

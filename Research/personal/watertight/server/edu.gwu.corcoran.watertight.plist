<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Watertight launchd service (per-user LaunchAgent).

  Install to  ~/Library/LaunchAgents/edu.gwu.corcoran.watertight.plist
  and edit the two paths plus the token below. install.sh does this for you.

  A LaunchAgent (not a LaunchDaemon) is deliberate: it runs as your user, so it
  can read files in your home directory and needs no root. The trade-off is
  that it starts when you log in, so the Mac mini must be logged in – see
  MINI-SETUP.md step 8 for enabling automatic login.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>edu.gwu.corcoran.watertight</string>

    <key>ProgramArguments</key>
    <array>
        <string>__VENV__/bin/python</string>
        <string>__APPDIR__/watertight_server.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__APPDIR__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>WATERTIGHT_TOKEN</key>
        <string>__TOKEN__</string>
        <key>PORT</key>
        <string>8765</string>
        <key>HOST</key>
        <string>0.0.0.0</string>
        <key>WATERTIGHT_MAX_MB</key>
        <string>200</string>
        <key>WATERTIGHT_WORKERS</key>
        <string>__WORKERS__</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <!-- Start at login and restart if it ever crashes. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- Do not hammer the machine if it is crash-looping on a bad config. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>__LOGDIR__/watertight.log</string>
    <key>StandardErrorPath</key>
    <string>__LOGDIR__/watertight.error.log</string>

    <!-- Mesh repair is CPU-heavy; keep it at normal priority so the machine
         stays responsive but jobs are not starved. -->
    <key>Nice</key>
    <integer>5</integer>

    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
